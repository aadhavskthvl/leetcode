def closestPrimes(self, left: int, right: int) -> list[int]:
        sieve = [True] * (right + 1)

        p = 2
        while p * p <= right:
            if sieve[p]:
                for i in range(p*p, right+1, p):
                    sieve[i] = False
            p += 1

        primes = []
        for i in range(max(2,left), right + 1):
            if sieve[i]:
                primes.append(i)
        
        if len(primes) < 2:
            return [-1,-1]

        min_diff = float("inf")
        final = []
        prev = primes[0]
        
        for i in range(1,len(primes)):
            if primes[i] - prev < min_diff:
                min_diff = primes[i] - prev
                final = [prev, primes[i]] 
            prev = primes[i]
        return final



            
